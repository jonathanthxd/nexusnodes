const plans = [
  { name: "Starter", ram: 4, cores: 1, desc: "Para servidores pequeños" },
  { name: "Esencial", ram: 8, cores: 2, desc: "El equilibrio para survival y plugins" },
  { name: "Avanzado", ram: 16, cores: 3, desc: "Más espacio para plugins y jugadores" },
  { name: "Pro", ram: 24, cores: 4, desc: "Comunidades que siguen creciendo" },
  { name: "Ultra", ram: 32, cores: 6, desc: "Proyectos grandes y modpacks" }
];

let pricePerGb = 0.50;

function cpuLabel(cores) {
  return (cores * 100) + "% CPU";
}

function renderPlans() {
  const root = document.getElementById("planGrid");
  if (!root) return;
  // Orden: del más barato al más caro (por RAM)
  const sorted = [...plans].sort((a, b) => a.ram - b.ram);
  root.innerHTML = sorted.map((p, i) => {
    const monthly = (p.ram * pricePerGb).toFixed(2);
    const featured = p.ram === 16 ? "featured" : "";
    return `
    <article class="price-card ${featured}">
      ${p.ram === 16 ? '<span class="badge">MÁS ELEGIDO</span>' : ""}
      <span>MINECRAFT</span>
      <h3>${p.name}</h3>
      <div class="price">$${monthly}<span>/mes</span></div>
      <p>${p.desc}</p>
      <ul>
        <li><span class="check">✓</span>${p.ram} GB RAM</li>
        <li><span class="check">✓</span>${cpuLabel(p.cores)}</li>
        <li><span class="check">✓</span>Pterodactyl</li>
        <li><span class="check">✓</span>Splits ilimitados</li>
      </ul>
      <a class="button primary full" href="/cuenta">Contratar</a>
    </article>`;
  }).join("");
}

function updateTotal() {
  const loc = document.getElementById("loc");
  const ram = document.getElementById("ram");
  const cores = document.getElementById("cores");
  const totalEl = document.getElementById("total");
  const cpuEl = document.getElementById("cpuLabel");
  if (!loc || !ram || !totalEl) return;
  const p = Number(loc.value);
  const r = Number(ram.value);
  const c = cores ? Number(cores.value) : 1;
  pricePerGb = p;
  totalEl.textContent = "$" + (p * r).toFixed(2);
  if (cpuEl) cpuEl.textContent = cpuLabel(c);
}

function initPlanes() {
  const selector = document.getElementById("selector");
  if (selector) {
    selector.querySelectorAll("button").forEach(btn => {
      btn.addEventListener("click", () => {
        selector.querySelectorAll("button").forEach(x => x.classList.remove("active"));
        btn.classList.add("active");
        pricePerGb = Number(btn.dataset.price);
        const loc = document.getElementById("loc");
        if (loc) loc.value = btn.dataset.price;
        renderPlans();
        updateTotal();
      });
    });
  }

  const loc = document.getElementById("loc");
  const ram = document.getElementById("ram");
  const cores = document.getElementById("cores");
  if (loc) loc.addEventListener("change", () => { pricePerGb = Number(loc.value); renderPlans(); updateTotal(); });
  if (ram) ram.addEventListener("change", updateTotal);
  if (cores) cores.addEventListener("change", updateTotal);

  renderPlans();
  updateTotal();
}

document.addEventListener("DOMContentLoaded", initPlanes);
